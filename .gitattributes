# Normalise text, never touch binaries
*            text=auto
*.py         text
*.json       text
*.md         text

*.png        binary
*.psd        binary
*.wav        binary
*.ogg        binary

# Godot - scenes/resources are text by design, keep them diffable
*.gd         text
*.tscn       text eol=lf
*.tres       text eol=lf
*.import     text
