; The fill is REVEALED, not resized. This clip is what changes width (see
; HangarTypeCard.refresh); the bolt inside it stays at full size, so its tip
; keeps its shape instead of being dragged in as the bar empties.
[node name="ProgressClip" type="Control" parent="AffinityRow/ProgressWrap"]
clip_contents = true
offset_right = 0.0
offset_bottom = 14.0

