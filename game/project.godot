; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Flight Tycoon"
run/main_scene="res://scenes/splash/Splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameClock="*res://scripts/game_clock.gd"
IsoGrid="*res://scripts/iso_grid.gd"
Maps="*res://scripts/maps.gd"
Friends="*res://scripts/friends.gd"
Economy="*res://scripts/economy.gd"
Fleet="*res://scripts/fleet.gd"
FuelStore="*res://scripts/fuel_store.gd"
FuelDepot="*res://scripts/fuel_depot.gd"
Progression="*res://scripts/progression.gd"
BuildingProgress="*res://scripts/building_progress.gd"
ApronProgress="*res://scripts/apron_progress.gd"
ZoneProgress="*res://scripts/zone_progress.gd"
Coins="*res://scripts/coins.gd"
ApronSkins="*res://scripts/apron_skins.gd"
AircraftAffinity="*res://scripts/aircraft_affinity.gd"
RunwayControl="*res://scripts/runway_control.gd"
DebugState="*res://scripts/debug_state.gd"
AircraftSkins="*res://scripts/aircraft_skins.gd"
Quests="*res://scripts/quests.gd"
DailyLogin="*res://scripts/daily_login.gd"
Boosts="*res://scripts/boosts.gd"
SaveGame="*res://scripts/save_game.gd"
Bot="*res://scripts/bot.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
