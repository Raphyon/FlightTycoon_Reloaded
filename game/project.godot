; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="ft-proto"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

IsoGrid="*res://scripts/iso_grid.gd"
Maps="*res://scripts/maps.gd"
Economy="*res://scripts/economy.gd"
Fleet="*res://scripts/fleet.gd"
FuelStore="*res://scripts/fuel_store.gd"
Progression="*res://scripts/progression.gd"
ApronProgress="*res://scripts/apron_progress.gd"
ZoneProgress="*res://scripts/zone_progress.gd"
Coins="*res://scripts/coins.gd"
ApronSkins="*res://scripts/apron_skins.gd"
AircraftAffinity="*res://scripts/aircraft_affinity.gd"
RunwayControl="*res://scripts/runway_control.gd"
DebugState="*res://scripts/debug_state.gd"

[display]

; 1152x648 is the reference frame everything was laid out against - it's
; Godot's own default viewport, so this pins the framing the editor has
; been showing all along rather than leaving it to whatever the window
; happens to be.
window/size/viewport_width=1152
window/size/viewport_height=648
; 3 = fullscreen.
window/size/mode=3
; Without this the stretch mode is "disabled", so a bigger window simply
; revealed more of the map instead of scaling anything - which is why
; fullscreen zoomed out rather than filling the screen. canvas_items
; scales the 2D content by the window/base ratio instead.
window/stretch/mode="canvas_items"
; "expand" keeps pixels square and fills the screen; a display whose aspect
; differs from 16:9 sees slightly more map on the wider axis rather than
; getting letterbox bars. "keep" instead would guarantee an identical frame
; but bar the edges.
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
